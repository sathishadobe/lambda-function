# Copy to `.env` for local testing only. Never commit `.env`.
#
# GitHub Actions:
#   Staging workflow: create secrets named with _STAGING (e.g. COMMERCE_BASE_URL_STAGING).
#   Production workflow: unsuffixed names (e.g. COMMERCE_BASE_URL).
# Lambda receives keys like COMMERCE_BASE_URL_STAGING (staging deploy) or COMMERCE_BASE_URL (prod).

# --- AWS (CI + optional Lambda env if in lambda-env-mapping) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SESSION_TOKEN=

# --- Adobe Commerce ---
COMMERCE_BASE_URL=
COMMERCE_CONSUMER_KEY=
COMMERCE_CONSUMER_SECRET=
COMMERCE_ACCESS_TOKEN=
COMMERCE_ACCESS_TOKEN_SECRET=
COMMERCE_OFFLINE_BOOKING_CANCEL_PATH=

# --- DMS ---
DMS_TOKEN_URL=
DMS_CLIENT_ID=
DMS_CLIENT_SECRET=
DMS_BOOKED_CARS_API_URL=
DMS_X_API_KEY=
